# Copy this file to .env and fill in the blanks: `cp .env.example .env`
# Docker Compose reads .env automatically; it is the single source of truth for
# every container. Never commit the real .env.

###> Application ###
APP_ENV=dev
APP_DEBUG=1
# Generate one with: openssl rand -hex 32
APP_SECRET=
###< Application ###

###> URLs ###
# Public origins, used by the browser and for the OAuth2 redirect URI.
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
###< URLs ###

###> Ports exposed on the host ###
API_PORT=8080
WEB_PORT=3000
# 3307 by default: a RedM dev machine usually already runs MySQL on 3306.
DB_PORT=3307
ADMINER_PORT=8081
###< Ports exposed on the host ###

###> Database ###
DB_NAME=mairie_valentine
DB_USER=mairie
DB_PASSWORD=mairie
DB_ROOT_PASSWORD=root
# Run the Doctrine migrations on container start.
AUTO_MIGRATE=1
###< Database ###

###> JWT ###
# Passphrase protecting the RSA keypair generated on first boot.
# Generate one with: openssl rand -hex 32
JWT_PASSPHRASE=
###< JWT ###

###> Discord OAuth2 ###
# https://discord.com/developers/applications -> OAuth2
# Redirect URI to declare: ${API_URL}/auth/discord/check
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: only members of this guild may sign in. Leave empty to allow anyone.
DISCORD_GUILD_ID=
###< Discord OAuth2 ###

###> Discord roles ###
# The positions at the town hall are read from the Discord roles, and rewritten
# there when the mayor promotes somebody. Needs a bot in the guild with the
# "Manage roles" permission and its own role above the three below.
# Leave DISCORD_BOT_TOKEN empty to manage `users.job` by hand in database.
DISCORD_BOT_TOKEN=
# Role identifiers (right click on the role, "Copy ID", developer mode on).
DISCORD_ROLE_MAIRE=
DISCORD_ROLE_ADJOINT=
DISCORD_ROLE_SECRETAIRE=
###< Discord roles ###

###> Dev tooling ###
# off | debug | develop | coverage
XDEBUG_MODE=off
###< Dev tooling ###
